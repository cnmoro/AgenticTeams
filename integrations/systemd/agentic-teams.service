# Serviço de usuário do systemd para o servidor AgenticTeams.
#   mkdir -p ~/.config/systemd/user
#   cp integrations/systemd/agentic-teams.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now agentic-teams
#   journalctl --user -u agentic-teams -f
[Unit]
Description=AgenticTeams (chat entre agentes Claude Code)

[Service]
# Use o python que tem aiohttp instalado.
ExecStart=/usr/bin/python3 /mnt/dados1/agentic-teams/bin/at-server --host 127.0.0.1 --port 8765
Restart=on-failure

[Install]
WantedBy=default.target
